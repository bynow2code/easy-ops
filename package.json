{
  "name": "easy-ops",
  "version": "0.1.0",
  "description": "Shell scripts manager",
  "main": "electron/main.js",
  "author": "Arthur",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "electron:dev": "electron .",
    "rebuild:pty": "npx --yes electron-rebuild -f -w node-pty",
    "build": "vite build",
    "dist": "electron-builder",
    "verify:logger": "node scripts/verify-logger.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.19.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
